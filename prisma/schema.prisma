generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskTier {
  Low
  Medium
  High
}

enum DecisionStatus {
  Approved
  Rejected
  Under_Investigation
}

model Applicant {
  id                  String          @id @default(cuid())
  branch              String
  category            String
  annualIncome        Float
  existingMonthlyDebt Float
  repaymentScore      Int
  loanAmount          Float
  tenureMonths        Int
  submittedAt         DateTime        @default(now())
  dti                 Float
  riskScore           Float
  riskTier            RiskTier
  decisions           Decision[]
  aiExplanation       AiExplanation?

  @@index([riskTier])
  @@index([category])
  @@index([branch])
}

model Decision {
  id          String         @id @default(cuid())
  applicantId String
  applicant   Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status      DecisionStatus
  officerName String
  comment     String
  createdAt   DateTime       @default(now())

  @@index([status])
  @@index([officerName])
  @@index([createdAt])
}

model AiExplanation {
  id          String    @id @default(cuid())
  applicantId String    @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  text        String
  generatedAt DateTime  @default(now())
}

model HistoricalDefaultRate {
  id       String @id @default(cuid())
  branch   String
  category String
  rate     Float

  @@unique([branch, category])
}
